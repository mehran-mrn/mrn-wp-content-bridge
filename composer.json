{
  "name": "mehran-mrn/mrn-wp-content-bridge",
  "description": "Modular WordPress content bridge for Telegram, Bale, LinkedIn and AI providers.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "autoload": {
    "psr-4": {
      "MRN\\ContentBridge\\": "src/"
    }
  },
  "scripts": {
    "lint": "php -r \"$it=new RecursiveIteratorIterator(new RecursiveDirectoryIterator('.'));foreach($it as $f){if($f->isFile()&&$f->getExtension()==='php'&&strpos($f->getPathname(),DIRECTORY_SEPARATOR.'vendor'.DIRECTORY_SEPARATOR)===false){passthru('php -l '.escapeshellarg($f->getPathname()),$c);if($c)exit($c);}}\"",
    "test": "phpunit"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
